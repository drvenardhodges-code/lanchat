rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // Phone numbers are kept in owner-only documents, never in the public profile directory.
    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Basic profiles, including an optional unverified phone number, are visible only to signed-in users.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'about', 'photoURL', 'phoneNumber', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 48
        && request.resource.data.about is string
        && request.resource.data.about.size() <= 140
        && request.resource.data.photoURL is string
        && (!('phoneNumber' in request.resource.data)
          || (request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 32));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Legacy phone-OTP accounts can only write the index for their verified Firebase Auth phone claim.
    // Email/password users are discovered through the optional phoneNumber profile field instead.
    match /phoneIndex/{phoneNumber} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.token.phone_number == phoneNumber
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && request.auth.token.phone_number == phoneNumber
        && resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.keys().hasOnly(['participants', 'createdAt', 'updatedAt', 'lastMessage']);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasOnly(['text', 'senderId', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }
  }
}
