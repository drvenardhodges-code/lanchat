rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function participantsNotBlocked(participants) {
      return !exists(/databases/$(database)/documents/users/$(participants[0])/blocked/$(participants[1]))
        && !exists(/databases/$(database)/documents/users/$(participants[1])/blocked/$(participants[0]));
    }

    // Phone numbers are kept in owner-only documents, never in the public profile directory.
    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      match /blocked/{blockedUid} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
          && request.resource.data.userId == blockedUid
          && request.resource.data.createdAt is timestamp;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Basic profiles, including an optional unverified phone number, are visible only to signed-in users.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'about', 'photoURL', 'phoneNumber', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 48
        && request.resource.data.about is string
        && request.resource.data.about.size() <= 140
        && request.resource.data.photoURL is string
        && (!('phoneNumber' in request.resource.data)
          || (request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 32));
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Legacy phone-OTP accounts can only write the index for their verified Firebase Auth phone claim.
    // Email/password users are discovered through the optional phoneNumber profile field instead.
    match /phoneIndex/{phoneNumber} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.auth.token.phone_number == phoneNumber
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn()
        && request.auth.token.phone_number == phoneNumber
        && resource.data.uid == request.auth.uid;
    }

    // Stories are visible to signed-in users only during their 24-hour lifetime.
    match /stories/{storyId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'userPhotoURL', 'text', 'mediaURL', 'mediaType', 'createdAt', 'expiresAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 48
        && request.resource.data.userPhotoURL is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.mediaURL is string
        && request.resource.data.mediaURL.size() <= 2048
        && request.resource.data.mediaType in ['text', 'image', 'video']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt == request.resource.data.createdAt + duration.value(24, 'h')
        && (request.resource.data.mediaType == 'text'
          ? (request.resource.data.mediaURL == '' && request.resource.data.text.size() > 0)
          : request.resource.data.mediaURL.size() > 0);
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      // Story views: each user can record their own view; only the owner lists viewers.
      match /views/{viewerId} {
        allow create, update: if signedIn()
          && request.auth.uid == viewerId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasOnly(['userId', 'userName', 'photoURL', 'viewedAt'])
          && request.resource.data.userName is string
          && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string)
          && request.resource.data.viewedAt is timestamp;
        allow get: if signedIn()
          && (request.auth.uid == viewerId
            || get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid);
        allow list: if signedIn()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == viewerId;
      }

      // One reaction per signed-in user per story.
      match /reactions/{reactorId} {
        allow get, list: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == reactorId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.emoji == '❤️'
          && request.resource.data.keys().hasOnly(['userId', 'userName', 'photoURL', 'emoji', 'createdAt'])
          && request.resource.data.userName is string
          && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string)
          && request.resource.data.createdAt is timestamp;
        allow delete: if signedIn() && request.auth.uid == reactorId;
      }
    }

    match /chats/{chatId} {
      // A signed-in user may check whether a deterministic chat document exists.
      // Existing chat data remains readable only by its two participants.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/chats/$(chatId))
          || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && participantsNotBlocked(request.resource.data.participants)
        && request.resource.data.keys().hasOnly(['participants', 'createdAt', 'updatedAt', 'lastMessage']);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && participantsNotBlocked(get(/databases/$(database)/documents/chats/$(chatId)).data.participants)
          && request.resource.data.keys().hasOnly(['text', 'senderId', 'createdAt', 'replyTo'])
          && (!('replyTo' in request.resource.data) || (request.resource.data.replyTo is map
            && request.resource.data.replyTo.keys().hasOnly(['messageId', 'text', 'senderName'])
            && request.resource.data.replyTo.messageId is string
            && request.resource.data.replyTo.text is string
            && request.resource.data.replyTo.senderName is string))
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000;
        allow update: if isChatMember(chatId) && resource.data.senderId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if isChatMember(chatId) && resource.data.senderId == request.auth.uid;
        match /reactions/{reactorId} {
          allow get, list: if isChatMember(chatId);
          allow create, update: if isChatMember(chatId) && request.auth.uid == reactorId && request.resource.data.keys().hasOnly(['userId', 'emoji', 'createdAt']) && request.resource.data.userId == request.auth.uid && request.resource.data.emoji in ['❤️', '😂', '👍', '🔥'] && request.resource.data.createdAt is timestamp;
          allow delete: if isChatMember(chatId) && request.auth.uid == reactorId;
        }
      }
    }
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['reporterId', 'reportedUserId', 'reason', 'createdAt', 'status']) && request.resource.data.reporterId == request.auth.uid && request.resource.data.reportedUserId is string && request.resource.data.reportedUserId != request.auth.uid && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500 && request.resource.data.createdAt is timestamp && request.resource.data.status == 'new';
      allow read, update, delete: if false;
    }
  }
}
